# /etc/copi-backup/backup.env
# Installed by scripts/backup/install.sh. Configures the periodic Postgres
# backup-and-restore-verification job.

# stack_name:container:db:user  (one per line)
STACKS="copi-python:copi-python-postgres-1:copi:copi
copi-blackbird:copi-blackbird-postgres-1:copi:copi"

BACKUP_ROOT=/var/backups/copi
# 3, not 5. Rebuilds on this host add Docker image layers and build cache faster
# than anything reclaims them, and backups share /dev/root with both pgdata volumes;
# 3 leaves ~1.95GB more headroom for that churn. The cost is a 3-day recovery window
# with no offsite copy -- see spec 12.1 and 12.10.
RETENTION_COUNT=3
RETENTION_UNVERIFIED=2

# MUST match the source server image, or pg_restore version skew is possible.
VERIFY_IMAGE=postgres:15
# Measured 2026-08-18: peak 195.4MiB restoring the 1333MB copi-python db.
# --memory is a limit, not a reservation; the headroom costs nothing.
VERIFY_MEM=768m
VERIFY_TIMEOUT_SEC=1800
# 7, not 3. Peak concurrent usage for one stack is ~2x the dump (container-side
# temp + host .partial) PLUS the restored verify volume (~2.3GB measured for
# copi-python), and prune runs last so an extra copy briefly coexists. Measured need
# ~3.74GB against the 2.16GB that factor 3 demanded.
FREE_SPACE_FACTOR=7

# An absolute floor, checked alongside the factor (free >= max(factor*dump, floor)).
# The factor scales with the stack being backed up, so on its own a small stack clears
# 7x a tiny dump on a nearly-full root filesystem and then starts a restore container
# on it. /var/backups/copi shares /dev/root with both pgdata volumes.
MIN_FREE_BYTES=2147483648

# Soft threshold: run, but log a WARNING and record it in status.json and the weekly
# heartbeat. 2x the hard requirement. The hard guard is binary -- green one night, dead
# the next -- and on 2026-09-15 this host crossed it in a single step with no warning.
# 0 disables. Keep it below normal headroom or it alarms continuously and gets ignored.
WARN_SPACE_FACTOR=14

# If this run's total row count OR dump_bytes falls more than this percent versus
# the most recent previous verified sidecar for the same stack, the run is marked
# FAILED (mailed, logged) and that stack's older copies are NOT pruned this run —
# they are kept as evidence pending human review. A legitimate bulk deletion trips
# this on purpose; that is intended.
REGRESSION_TOLERANCE_PCT=20

# Empty = local only. Contract: exit 0 = durably stored. Invoked as
#   $OFFSITE_CMD <dump> <sidecar>
OFFSITE_CMD=""

AWS_REGION=us-east-2
SES_SENDER_EMAIL=CHANGEME@copi.science
MAIL_TO="malanjary@scripps.edu ahuebschen@scripps.edu asu@scripps.edu"
