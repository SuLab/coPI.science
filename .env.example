# ORCID OAuth
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_REDIRECT_URI=http://localhost:8000/auth/callback

# Database
DATABASE_URL=postgresql+asyncpg://copi:copi@postgres:5432/copi

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: model for company discovery's COI founder extraction (default
# claude-opus-5-5). Must be priced in src/services/llm_pricing.py.
# LLM_COI_MODEL=claude-opus-5-5

# NCBI E-utilities
NCBI_API_KEY=your-ncbi-api-key

# SEC EDGAR + Wikidata (company discovery). Sent verbatim as the SEC User-Agent, which
# SEC requires as "<Company Name> <admin email>"; its address is also the Wikidata
# contact. Empty = discovery still suggests companies, without funding ("funding lookup
# unavailable") and without Wikidata.
SEC_USER_AGENT=

# App
# Deployment environment. Any value other than development/dev/local/test makes
# the app refuse to start with the insecure default SECRET_KEY. Set to
# "production" on real deployments.
ENVIRONMENT=development
# IMPORTANT: Generate a strong random SECRET_KEY (e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ). It signs session cookies. Never commit real values;
# outside development the app fails fast if this is unset or left at the default.
SECRET_KEY=change-me-to-a-strong-random-string-at-least-32-chars
BASE_URL=http://localhost:8000

# Session cookies are Secure (https-only) by default. Set to true ONLY for local
# HTTP development — never in production, where it would allow cookies over HTTP.
ALLOW_HTTP_SESSIONS=true

# Slack — one Bot User OAuth Token per agent. The SLACK_APP_TOKEN_* lines are no
# longer read: Socket Mode was dropped (see alembic 0013).
SLACK_BOT_TOKEN_SU=xoxb-placeholder
SLACK_APP_TOKEN_SU=xapp-placeholder
SLACK_BOT_TOKEN_WISEMAN=xoxb-placeholder
SLACK_APP_TOKEN_WISEMAN=xapp-placeholder
SLACK_BOT_TOKEN_LOTZ=xoxb-placeholder
SLACK_APP_TOKEN_LOTZ=xapp-placeholder
SLACK_BOT_TOKEN_CRAVATT=xoxb-placeholder
SLACK_APP_TOKEN_CRAVATT=xapp-placeholder
SLACK_BOT_TOKEN_GROTJAHN=xoxb-placeholder
SLACK_APP_TOKEN_GROTJAHN=xapp-placeholder
SLACK_BOT_TOKEN_PETRASCHECK=xoxb-placeholder
SLACK_APP_TOKEN_PETRASCHECK=xapp-placeholder
SLACK_BOT_TOKEN_KEN=xoxb-placeholder
SLACK_APP_TOKEN_KEN=xapp-placeholder
SLACK_BOT_TOKEN_RACKI=xoxb-placeholder
SLACK_APP_TOKEN_RACKI=xapp-placeholder
SLACK_BOT_TOKEN_SAEZ=xoxb-placeholder
SLACK_APP_TOKEN_SAEZ=xapp-placeholder
SLACK_BOT_TOKEN_WU=xoxb-placeholder
SLACK_APP_TOKEN_WU=xapp-placeholder
